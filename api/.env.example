# 优先读 api/.hf；本文件用于覆盖。模型根目录：HF_MODELS_ROOT（默认项目根 .hf 文件夹）。

CAPTION_MODEL_DIR=
ZH_EN_MODEL_DIR=
EN_ZH_MODEL_DIR=
# HF_MODELS_ROOT=../.hf

# 可选：仅监听本机
# HOST=127.0.0.1
# PORT=8787

# ---------- MinIO（人物百科、临时插画图片等，与 minio/ 目录下服务对应）----------
# 临时插画元数据 SQLite（可选，默认 api/data/temp_illustrations.db）
# TEMP_ILLUSTRATIONS_DB_PATH=
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin123
# 若未设置 ACCESS/SECRET，会回退读取 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
# MINIO_BUCKET=myimage
# MINIO_SECURE=false
# MINIO_PRESIGN_GET_HOURS=24

# ---------- 人物百科 SQLite（默认 api/data/characters.db）----------
# CHARACTERS_DB_PATH=

# ---------- 提示词词库 SQLite（默认 api/data/prompt_library.db）----------
# PROMPT_LIBRARY_DB_PATH=
