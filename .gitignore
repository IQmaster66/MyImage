api/.venv/
api/__pycache__/
api/**/__pycache__/
*.py[cod]
# api/.hf/ 若需推送可删掉本行（注意体积）
api/data/

# Node (web)
web/node_modules/
web/.next/
web/out/
web/build/
web/.vercel
*.tsbuildinfo
web/next-env.d.ts

# 环境与密钥（勿提交）
.env
.env.*
!.env.example
!api/.env.example
!api/.hf.example
api/.env

# 日志与系统
*.log
.DS_Store
Thumbs.db
*.pem

# MinIO：可推送数据与脚本；可执行文件超过 GitHub 100MB 单文件上限
minio/minio.exe
minio/mc.exe

# Hugging Face 缓存（约 10GB+，GitHub 无法直接推送，见 README）
